# Copy thành `.env` rồi điền giá trị thật. Không commit `.env`.
PORT=4000
API_PREFIX=/api
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# Đổi pass sau lần `docker compose up` đầu tiên phải reset volume: docker compose down -v && docker compose up -d
MYSQL_PASSWORD=
MYSQL_DATABASE=nro1
DB_POOL_LIMIT=10
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
